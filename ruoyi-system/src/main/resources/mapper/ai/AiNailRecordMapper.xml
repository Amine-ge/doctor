<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ai.mapper.AiNailRecordMapper">
    
    <resultMap type="AiNailRecord" id="AiNailRecordResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="imageUrl"    column="image_url"    />
        <result property="nqDetected"    column="nq_detected"    />
        <result property="nqQualityScore"    column="nq_quality_score"    />
        <result property="nqLightingOk"    column="nq_lighting_ok"    />
        <result property="nqOcclusionOk"    column="nq_occlusion_ok"    />
        <result property="nailColor"    column="nail_color"    />
        <result property="nailTexture"    column="nail_texture"    />
        <result property="nailShape"    column="nail_shape"    />
        <result property="lunulaVisibility"    column="lunula_visibility"    />
        <result property="breakability"    column="breakability"    />
        <result property="notes"    column="notes"    />
        <result property="visionJson"    column="vision_json"    />
        <result property="aiDiagnosis"    column="ai_diagnosis"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
        <result property="healthScore"    column="health_score"    />

    </resultMap>

    <sql id="selectAiNailRecordVo">
        select id, user_id, image_url, nq_detected, nq_quality_score, nq_lighting_ok, nq_occlusion_ok, nail_color, nail_texture, nail_shape, lunula_visibility, breakability, notes, vision_json, ai_diagnosis, created_at, updated_at, health_score from ai_nail_record
    </sql>

    <select id="selectAiNailRecordList" parameterType="AiNailRecord" resultMap="AiNailRecordResult">
        <include refid="selectAiNailRecordVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="imageUrl != null  and imageUrl != ''"> and image_url = #{imageUrl}</if>
            <if test="nqDetected != null "> and nq_detected = #{nqDetected}</if>
            <if test="nqQualityScore != null "> and nq_quality_score = #{nqQualityScore}</if>
            <if test="nqLightingOk != null "> and nq_lighting_ok = #{nqLightingOk}</if>
            <if test="nqOcclusionOk != null "> and nq_occlusion_ok = #{nqOcclusionOk}</if>
            <if test="nailColor != null  and nailColor != ''"> and nail_color = #{nailColor}</if>
            <if test="nailTexture != null  and nailTexture != ''"> and nail_texture = #{nailTexture}</if>
            <if test="nailShape != null  and nailShape != ''"> and nail_shape = #{nailShape}</if>
            <if test="lunulaVisibility != null  and lunulaVisibility != ''"> and lunula_visibility = #{lunulaVisibility}</if>
            <if test="breakability != null  and breakability != ''"> and breakability = #{breakability}</if>
            <if test="notes != null  and notes != ''"> and notes = #{notes}</if>
            <if test="visionJson != null  and visionJson != ''"> and vision_json = #{visionJson}</if>
            <if test="aiDiagnosis != null  and aiDiagnosis != ''"> and ai_diagnosis = #{aiDiagnosis}</if>
            <if test="createdAt != null "> and created_at = #{createdAt}</if>
            <if test="updatedAt != null "> and updated_at = #{updatedAt}</if>
            <if test="healthScore != null "> and health_score = #{healthScore}</if>
        </where>
        order by created_at desc
    </select>
    
    <select id="selectAiNailRecordById" parameterType="Long" resultMap="AiNailRecordResult">
        <include refid="selectAiNailRecordVo"/>
        where id = #{id}
    </select>
    <select id="selectLatestByUserAfter" resultType="com.ruoyi.ai.domain.AiNailRecord">
        SELECT *
        FROM ai_nail_record
        WHERE user_id = #{userId}
          AND created_at >= #{since}
        ORDER BY created_at DESC, id DESC
            LIMIT 1
    </select>


    <insert id="insertAiNailRecord" parameterType="AiNailRecord" useGeneratedKeys="true" keyProperty="id">
        insert into ai_nail_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="imageUrl != null">image_url,</if>
            <if test="nqDetected != null">nq_detected,</if>
            <if test="nqQualityScore != null">nq_quality_score,</if>
            <if test="nqLightingOk != null">nq_lighting_ok,</if>
            <if test="nqOcclusionOk != null">nq_occlusion_ok,</if>
            <if test="nailColor != null">nail_color,</if>
            <if test="nailTexture != null">nail_texture,</if>
            <if test="nailShape != null">nail_shape,</if>
            <if test="lunulaVisibility != null">lunula_visibility,</if>
            <if test="breakability != null">breakability,</if>
            <if test="notes != null">notes,</if>
            <if test="visionJson != null">vision_json,</if>
            <if test="aiDiagnosis != null">ai_diagnosis,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
            <if test="healthScore != null">health_score,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="imageUrl != null">#{imageUrl},</if>
            <if test="nqDetected != null">#{nqDetected},</if>
            <if test="nqQualityScore != null">#{nqQualityScore},</if>
            <if test="nqLightingOk != null">#{nqLightingOk},</if>
            <if test="nqOcclusionOk != null">#{nqOcclusionOk},</if>
            <if test="nailColor != null">#{nailColor},</if>
            <if test="nailTexture != null">#{nailTexture},</if>
            <if test="nailShape != null">#{nailShape},</if>
            <if test="lunulaVisibility != null">#{lunulaVisibility},</if>
            <if test="breakability != null">#{breakability},</if>
            <if test="notes != null">#{notes},</if>
            <if test="visionJson != null">#{visionJson},</if>
            <if test="aiDiagnosis != null">#{aiDiagnosis},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
            <if test="healthScore != null">#{healthScore},</if>
         </trim>
    </insert>

    <update id="updateAiNailRecord" parameterType="AiNailRecord">
        update ai_nail_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="nqDetected != null">nq_detected = #{nqDetected},</if>
            <if test="nqQualityScore != null">nq_quality_score = #{nqQualityScore},</if>
            <if test="nqLightingOk != null">nq_lighting_ok = #{nqLightingOk},</if>
            <if test="nqOcclusionOk != null">nq_occlusion_ok = #{nqOcclusionOk},</if>
            <if test="nailColor != null">nail_color = #{nailColor},</if>
            <if test="nailTexture != null">nail_texture = #{nailTexture},</if>
            <if test="nailShape != null">nail_shape = #{nailShape},</if>
            <if test="lunulaVisibility != null">lunula_visibility = #{lunulaVisibility},</if>
            <if test="breakability != null">breakability = #{breakability},</if>
            <if test="notes != null">notes = #{notes},</if>
            <if test="visionJson != null">vision_json = #{visionJson},</if>
            <if test="aiDiagnosis != null">ai_diagnosis = #{aiDiagnosis},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
            <if test="healthScore != null">health_score = #{healthScore},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAiNailRecordById" parameterType="Long">
        delete from ai_nail_record where id = #{id}
    </delete>

    <delete id="deleteAiNailRecordByIds" parameterType="String">
        delete from ai_nail_record where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectDailyNailScore" resultType="com.ruoyi.ai.domain.HealthDailyScoreDO">
        SELECT
            DATE(created_at) AS day,
            AVG(health_score) AS nailScore
        FROM ai_nail_record
        WHERE user_id = #{userId}
          AND created_at BETWEEN #{start} AND #{end}
        GROUP BY DATE(created_at)
    </select>

</mapper>