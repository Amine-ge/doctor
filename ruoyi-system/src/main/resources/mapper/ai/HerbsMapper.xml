<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ai.mapper.HerbsMapper">
    
    <resultMap type="Herbs" id="HerbsResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="alias"    column="alias"    />
        <result property="category"    column="category"    />
        <result property="effect"    column="effect"    />
        <result property="origin"    column="origin"    />
        <result property="warning"    column="warning"    />
        <result property="imageUrl"    column="image_url"    />
        <result property="description"    column="description"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectHerbsVo">
        select id, name, alias, category, effect, origin, warning, image_url, description, create_time, update_time from herbs
    </sql>

    <select id="selectHerbsList" parameterType="Herbs" resultMap="HerbsResult">
        <include refid="selectHerbsVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="alias != null  and alias != ''"> and alias = #{alias}</if>
            <if test="category != null  and category != ''"> and category = #{category}</if>
            <if test="effect != null  and effect != ''"> and effect = #{effect}</if>
            <if test="origin != null  and origin != ''"> and origin = #{origin}</if>
            <if test="warning != null  and warning != ''"> and warning = #{warning}</if>
            <if test="imageUrl != null  and imageUrl != ''"> and image_url = #{imageUrl}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
        </where>
    </select>
    
    <select id="selectHerbsById" parameterType="Long" resultMap="HerbsResult">
        <include refid="selectHerbsVo"/>
        where id = #{id}
    </select>

    <insert id="insertHerbs" parameterType="Herbs" useGeneratedKeys="true" keyProperty="id">
        insert into herbs
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="alias != null">alias,</if>
            <if test="category != null">category,</if>
            <if test="effect != null and effect != ''">effect,</if>
            <if test="origin != null">origin,</if>
            <if test="warning != null">warning,</if>
            <if test="imageUrl != null">image_url,</if>
            <if test="description != null">description,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="alias != null">#{alias},</if>
            <if test="category != null">#{category},</if>
            <if test="effect != null and effect != ''">#{effect},</if>
            <if test="origin != null">#{origin},</if>
            <if test="warning != null">#{warning},</if>
            <if test="imageUrl != null">#{imageUrl},</if>
            <if test="description != null">#{description},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateHerbs" parameterType="Herbs">
        update herbs
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="alias != null">alias = #{alias},</if>
            <if test="category != null">category = #{category},</if>
            <if test="effect != null and effect != ''">effect = #{effect},</if>
            <if test="origin != null">origin = #{origin},</if>
            <if test="warning != null">warning = #{warning},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="description != null">description = #{description},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteHerbsById" parameterType="Long">
        delete from herbs where id = #{id}
    </delete>

    <delete id="deleteHerbsByIds" parameterType="String">
        delete from herbs where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>